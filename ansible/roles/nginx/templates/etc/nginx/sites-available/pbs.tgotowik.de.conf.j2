server {
    listen 80;
    listen [::]:80;
    server_name "{{ dict_backends.pbs.domain }}";

    rewrite ^(.*) https://$host$1 permanent;
}
 
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name "{{ dict_backends.pbs.domain }}";

    ssl_certificate {{ str_webserver_certificate }};
    ssl_certificate_key {{ str_webserver_key }};

    proxy_redirect off;
    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass https://{{ dict_backends.pbs.address }}:{{ dict_backends.pbs.port }};
        proxy_buffering off;
        client_max_body_size 0;
        proxy_connect_timeout  3600s;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        send_timeout  3600s;
    }
}