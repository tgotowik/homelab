server {
    listen 80;
    listen [::]:80;
    server_name {{ dict_backends.budget.domain }};
    # Redirection from HTTP site to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    ssl_certificate {{ str_webserver_certificate }};
    ssl_certificate_key {{ str_webserver_key }};

    server_name {{ dict_backends.budget.domain }};



    location / {
            add_header X-Robots-Tag "noindex, nofollow";

            # Explicitly set mandatory security headers
            add_header Cross-Origin-Embedder-Policy "require-corp" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            add_header Origin-Agent-Cluster "?1" always;

            proxy_pass http://{{ dict_backends.budget.address }}:{{ dict_backends.budget.port }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Prevents header duplication between Upstream and Proxy
            proxy_hide_header Cross-Origin-Embedder-Policy;
            proxy_hide_header Cross-Origin-Opener-Policy;

            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_cache_bypass $http_upgrade;
    }

    access_log /var/log/nginx/budget-access.log;
    error_log /var/log/nginx/budget-error.log debug;
}