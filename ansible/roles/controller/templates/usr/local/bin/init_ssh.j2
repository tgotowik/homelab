#!/usr/bin/env bash

# Liste der hinzuzufügenden SSH-Keys
SSH_KEYS=(
    "{{ ansible_ssh_private_key_file }}"
    # "/home/tgotowik/.ssh/id_pve"
)

# 1. Prüfen, ob bereits ein funktionierender Agent läuft
if ! ssh-add -l > /dev/null 2>&1; then
    echo "Starte neuen SSH-Agent..."
    eval "$(ssh-agent -s)" > /dev/null
else
    echo "SSH-Agent läuft bereits."
fi

# 2. Definierte Keys laden, falls sie noch nicht im Agenten sind
for KEY in "${SSH_KEYS[@]}"; do
    if [ -f "$KEY" ]; then
        # Fingerprint des Keys ermitteln
        KEY_FP=$(ssh-keygen -lf "$KEY" 2>/dev/null | awk '{print $2}')

        # Prüfen, ob der Fingerprint bereits im Agenten geladen ist
        if ! ssh-add -L 2>/dev/null | grep -q "$KEY_FP"; then
            echo "Lade SSH-Key: $KEY"
            ssh-add "$KEY"
        else
            echo "SSH-Key bereits geladen: $KEY"
        fi
    else
        echo "WARNUNG: Key-Datei nicht gefunden: $KEY"
    fi
done